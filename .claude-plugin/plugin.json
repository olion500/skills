{
  "name": "olion500-skills",
  "version": "1.3.0",
  "description": "Agent skills: FP, Slack, Jira, Datadog, Kibana, Azure DevOps, and utilities for Claude Code",
  "author": {
    "name": "olion500"
  },
  "homepage": "https://github.com/olion500/skills",
  "repository": "https://github.com/olion500/skills",
  "license": "MIT",
  "keywords": ["functional-programming", "fp", "slack", "jira", "datadog", "kibana", "azure-devops", "search", "tools"],
  "userConfig": {
    "slack_user_token": {
      "type": "string",
      "title": "Slack User Token",
      "description": "xoxp-... token with search:read scope",
      "sensitive": true
    },
    "slack_bot_token": {
      "type": "string",
      "title": "Slack Bot Token",
      "description": "xoxb-... token with channels:read, users:read scopes",
      "sensitive": true
    },
    "jira_url": {
      "type": "string",
      "title": "Jira URL",
      "description": "e.g. https://yourteam.atlassian.net"
    },
    "jira_username": {
      "type": "string",
      "title": "Jira Username",
      "description": "Atlassian account email"
    },
    "jira_api_token": {
      "type": "string",
      "title": "Jira API Token",
      "description": "Atlassian API token",
      "sensitive": true
    },
    "datadog_api_key": {
      "type": "string",
      "title": "Datadog API Key",
      "description": "Datadog API key for log search and metrics",
      "sensitive": true
    },
    "datadog_app_key": {
      "type": "string",
      "title": "Datadog App Key",
      "description": "Datadog Application key",
      "sensitive": true
    },
    "kibana_username": {
      "type": "string",
      "title": "Kibana Username",
      "description": "Kibana/Elasticsearch username"
    },
    "kibana_password": {
      "type": "string",
      "title": "Kibana Password",
      "description": "Kibana/Elasticsearch password",
      "sensitive": true
    }
  }
}
