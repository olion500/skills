{
  "name": "olion500-skills",
  "version": "1.2.0",
  "description": "Agent skills: functional programming, utilities, Slack tools, and Jira CLI for Claude Code",
  "author": {
    "name": "olion500"
  },
  "homepage": "https://github.com/olion500/skills",
  "repository": "https://github.com/olion500/skills",
  "license": "MIT",
  "keywords": ["functional-programming", "fp", "slack", "jira", "search", "tools"],
  "userConfig": {
    "slack_user_token": {
      "type": "string",
      "title": "Slack User Token",
      "description": "xoxp-... token with search:read scope",
      "sensitive": true
    },
    "slack_bot_token": {
      "type": "string",
      "title": "Slack Bot Token",
      "description": "xoxb-... token with channels:read, users:read scopes",
      "sensitive": true
    },
    "jira_url": {
      "type": "string",
      "title": "Jira URL",
      "description": "e.g. https://yourteam.atlassian.net"
    },
    "jira_username": {
      "type": "string",
      "title": "Jira Username",
      "description": "Atlassian account email"
    },
    "jira_api_token": {
      "type": "string",
      "title": "Jira API Token",
      "description": "Atlassian API token",
      "sensitive": true
    }
  }
}
